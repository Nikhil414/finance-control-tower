# Copy to .env and fill in. .env is gitignored; never commit real values.

# PostgreSQL. The pipeline defaults to this exact DSN if DATABASE_URL is unset.
DATABASE_URL=host=127.0.0.1 port=5432 dbname=finance_capstone user=postgres password=admin

# AI investigator. Entirely optional.
#
# With no key the pipeline still runs end to end: SQL controls, leakage
# detection, reconciliation, the Excel queue and Power BI all work, and the
# executive brief falls back to a deterministic template built from the
# findings themselves. AI is an annotation layer, never a dependency.
#
# Set ONE of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# DeepSeek only: override if routing through a gateway (e.g. TokenHarbor)
# instead of api.deepseek.com directly.
DEEPSEEK_BASE_URL=

# Model to call. Leave unset for the provider default.
AI_MODEL=

# Set to 1 to skip the AI step entirely, e.g. to demo the outage path.
AI_DISABLED=0

# Jev (typesafe.ai). Optional, independent of the narrative provider above.
# Scores each finding's false-positive likelihood as a triage hint for the
# reviewer -- advisory only, never written to a finding's status.
TYPESAFE_API_KEY=
