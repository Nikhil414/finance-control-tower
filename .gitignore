# Secrets - never commit. AI keys and DB credentials live in .env only.
.env
.env.local
*.env
!.env.example
APIKEY.txt
*credentials*
*secret*

# Test scratch
suite_result.txt
*.e2e-backup

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Generated pipeline outputs. Regenerated by `python src/run_pipeline.py`;
# committing them makes diffs unreadable and lets stale numbers look current.
outputs/*
!outputs/.gitkeep

# Excel review round-trip. The workbook template is committed; filled-in
# reviewer files are operational data, not source.
excel/review_decisions*.csv
~$*.xlsx

# Power BI
*.pbix.bak

# Local tooling and AI-assistant config
data-formulator/
.claude/
.codex/
.mcp.json

# Personal notes
docs/JPM_*

# Scratch / duplicates (curated copies live in docs/images/)
all BI screenshot/
Complete_powerbi_image.png
docs/architecture.visual-check.*
docs/dashboard-design/*.zip

# OS
Thumbs.db
.DS_Store
desktop.ini

# Raw Power BI exports (curated copies in docs/images/)
Complete_photo/
